{
  "manifest_version": 3,
  "name": "勤務表自動承認",
  "version": "1.0.0",
  "description": "勤務表の日次承認を自動化するChrome拡張機能",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "勤務表自動承認"
  },
  "content_scripts": [],
  "host_permissions": [
    "<all_urls>"
  ]
}
